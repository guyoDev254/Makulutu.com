# Copy to .env (never commit real secrets).

NODE_ENV=development
PORT=2000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/makulutu

JWT_SECRET=change-me
FAN_JWT_SECRET=
CREATOR_JWT_SECRET=

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Paystack: Kenya M-Pesa STK + hosted checkout (cards / other countries, charged in KES).
# Payouts: enable Transfers in Paystack, keep enough balance, and disable transfer OTP.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES

SENDGRID_API_KEY=
# cPanel mailbox: mail.makulutu.com (SSL 465). Do not use smtp.safaricombusiness.co.ke from cloud/IPv6.
SMTP_HOST=mail.makulutu.com
SMTP_PORT=465
SMTP_USER=no-reply@makulutu.com
# Quote if the password contains # or spaces: SMTP_PASS='your-password'
SMTP_PASS=
EMAIL_FROM=no-reply@makulutu.local
EMAIL_FROM_NAME=Makulutu
EMAIL_REPLY_TO=
ADMIN_REVIEW_EMAIL=
# Production seed (admin only): yarn prisma:seed:prod
ADMIN_USERNAME=makulutu
ADMIN_EMAIL=g.abduba43@gmail.com
ADMIN_PASSWORD=

AWS_REGION=eu-north-1
AWS_S3_BUCKET=makulutu
# Do not set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.
# Production EC2 uses IAM role MakulutuEC2S3Role via the SDK default provider chain.
# Locally, use `aws configure` (credentials stay in ~/.aws, never in git).

GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

OBS_ALERT_SECRET=
OBS_PLAYER_BASE_URL=http://localhost:2000
