// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String?
  tiktokUsername String?   @map("tiktok_username")
  mpesaMobile    String?   @map("mpesa_mobile")
  whatsappNumber String?   @map("whatsapp_number")
  isActive       Boolean?  @default(true) @map("is_active")
  addedToWhatsApp Boolean? @default(false) @map("added_to_whatsapp")
  /// Supporter account scoped to a creator (null = legacy before multi-tenant).
  creatorId      String?   @map("creator_id")
  /// Logged-in fan account (null = guest checkout row).
  fanId          String?   @map("fan_id")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  creator       Creator?       @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  fan           Fan?           @relation(fields: [fanId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  payments      Payment[]

  @@unique([tiktokUsername, creatorId])
  @@index([creatorId])
  @@index([fanId])
  @@map("users")
}

/// Fan account (mobile app). Distinct from per-creator supporter `User` rows.
model Fan {
  id                   String    @id @default(uuid())
  phone                String?   @unique @db.VarChar(20)
  email                String?   @unique @db.VarChar(190)
  password             String?
  googleId             String?   @unique @map("google_id") @db.VarChar(64)
  name                 String?   @db.VarChar(80)
  tiktokUsername       String?   @map("tiktok_username") @db.VarChar(64)
  otpHash              String?   @map("otp_hash") @db.VarChar(128)
  otpExpiresAt         DateTime? @map("otp_expires_at")
  otpSentAt            DateTime? @map("otp_sent_at")
  emailOtpHash         String?   @map("email_otp_hash") @db.VarChar(128)
  emailOtpExpiresAt    DateTime? @map("email_otp_expires_at")
  emailOtpSentAt       DateTime? @map("email_otp_sent_at")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  isActive             Boolean   @default(true) @map("is_active")
  lastLogin            DateTime? @map("last_login")
  avatarUrl            String?   @map("avatar_url") @db.VarChar(500)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  locale               String    @default("en") @db.VarChar(8)
  showOnLeaderboard    Boolean   @default(true) @map("show_on_leaderboard")
  expoPushToken        String?   @map("expo_push_token") @db.VarChar(200)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users         User[]
  follows       FanFollow[]
  notifications FanNotification[]

  @@map("fans")
}

model FanFollow {
  id        String   @id @default(uuid())
  fanId     String   @map("fan_id")
  creatorId String   @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at")

  fan     Fan     @relation(fields: [fanId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([fanId, creatorId])
  @@index([fanId, createdAt(sort: Desc)])
  @@map("fan_follows")
}

model FanNotification {
  id          String    @id @default(uuid())
  fanId       String    @map("fan_id")
  type        String    @db.VarChar(40)
  title       String    @db.VarChar(120)
  body        String    @db.VarChar(280)
  creatorSlug String?   @map("creator_slug") @db.VarChar(64)
  refId       String    @map("ref_id") @db.VarChar(80)
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  fan Fan @relation(fields: [fanId], references: [id], onDelete: Cascade)

  @@unique([fanId, type, refId])
  @@index([fanId, createdAt(sort: Desc)])
  @@map("fan_notifications")
}

/// Paid shoutout checkout data (separate from subscription billing). Linked 1:1 to Payment when purpose is STREAM_ALERT.
model StreamShoutout {
  id            String   @id @default(uuid())
  paymentId     String   @unique @map("payment_id")
  displayHandle String   @map("display_handle") @db.VarChar(64)
  platform      String   @db.VarChar(32)
  message       String?  @db.VarChar(500)
  /// Optional TikTok page URL for OBS embed (validated at checkout).
  videoUrl      String?  @map("video_url") @db.VarChar(500)
  amountKes     Decimal  @map("amount_kes") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("stream_shoutouts")
}

model Subscription {
  id        String              @id @default(uuid())
  userId    String?             @map("user_id")
  months    Int?
  startDate DateTime?           @map("start_date") @db.Date
  endDate   DateTime?           @map("end_date") @db.Date
  status    SubscriptionStatus? @default(ACTIVE)
  amount    Decimal?            @db.Decimal(10, 2)
  paymentId String?             @map("payment_id")
  creatorId String?             @map("creator_id")
  /// Fan country selected at membership checkout (KE, US, OTHER, …).
  checkoutCountry String?       @map("checkout_country") @db.VarChar(8)
  createdAt DateTime?           @default(now()) @map("created_at")
  updatedAt DateTime?           @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentPurpose {
  SUBSCRIPTION
  STREAM_ALERT
  COACHING_BOOKING
  CREATOR_REWARD
}

enum PaymentMethod {
  MPESA
  PAYPAL
  PAYSTACK
}

model Payment {
  id                       String         @id @default(uuid())
  userId                   String?        @map("user_id")
  creatorId                String?        @map("creator_id")
  amount                   Decimal?       @db.Decimal(10, 2)
  months                   Int?           @default(1)
  purpose                  PaymentPurpose? @default(SUBSCRIPTION) @map("purpose")
  paymentMethod            PaymentMethod  @default(MPESA) @map("payment_method")
  status                   PaymentStatus? @default(PENDING)
  /// PayPal Checkout order ID (v2/orders) while pending or after capture.
  paypalOrderId            String?        @map("paypal_order_id")
  transactionRequestId     String?        @map("transaction_request_id")
  transactionId            String?        @map("transaction_id")
  transactionReceipt       String?        @map("transaction_receipt")
  merchantRequestId        String?        @map("merchant_request_id")
  checkoutRequestId        String?        @map("checkout_request_id")
  reference                String?
  /// Legacy DB column from earlier subscribe flow — keep mapped so `db push` does not drop data.
  subscriberMessage        String?        @map("subscriber_message") @db.VarChar(500)
  subscriberPlatform       String?        @map("subscriber_platform") @db.VarChar(32)
  giftRecipientName        String?        @map("gift_recipient_name") @db.VarChar(80)
  giftRecipientPhone       String?        @map("gift_recipient_phone") @db.VarChar(20)
  /// Fan country selected at checkout (membership and other catalog payments).
  checkoutCountry          String?        @map("checkout_country") @db.VarChar(8)
  /// Legacy shoutout fields — prefer `streamShoutout` for new rows.
  streamAlertHandle        String?        @map("stream_alert_handle") @db.VarChar(64)
  streamAlertPlatform      String?        @map("stream_alert_platform") @db.VarChar(32)
  streamAlertMessage       String?        @map("stream_alert_message") @db.VarChar(100)
  streamShoutout           StreamShoutout?
  creatorRewardPurchase    CreatorRewardPurchase?
  coachingBookings         CoachingBooking[]
  failureReason            String?        @map("failure_reason")
  completedAt              DateTime?      @map("completed_at")
  /// Set when the subscriber OBS alert has been sent for this payment (idempotent across webhook vs poll).
  subscriberAlertEmittedAt DateTime?      @map("subscriber_alert_emitted_at")
  failedAt                 DateTime?      @map("failed_at")
  /// Snapshot of the split at the moment the payment was verified (ledger source of truth).
  platformFeeKes           Decimal?       @map("platform_fee_kes") @db.Decimal(14, 2)
  creatorAmountKes         Decimal?       @map("creator_amount_kes") @db.Decimal(14, 2)
  feePercentSnapshot       Decimal?       @map("fee_percent_snapshot") @db.Decimal(6, 2)
  settlementStatus         SettlementStatus? @map("settlement_status")
  settleAt                 DateTime?      @map("settle_at")
  settledAt                DateTime?      @map("settled_at")
  ledgerPostedAt           DateTime?      @map("ledger_posted_at")
  refundedAt               DateTime?      @map("refunded_at")
  createdAt                DateTime?      @default(now()) @map("created_at")
  updatedAt                DateTime?      @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  refund           PaymentRefund?
  ledgerEntries    LedgerEntry[]

  @@index([creatorId])
  @@index([paypalOrderId])
  @@index([settlementStatus, settleAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  SETTLED
  REFUNDED
  ADJUSTED
}

enum LedgerEntryType {
  PAYMENT_EARNING
  PLATFORM_FEE
  SETTLEMENT
  REFUND
  REFUND_REVERSAL
  WITHDRAWAL_RESERVATION
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  WITHDRAWAL_FEE
  ADJUSTMENT
}

enum LedgerAccount {
  CREATOR_PENDING
  CREATOR_AVAILABLE
  CREATOR_RESERVED
  CREATOR_DEBT
  PLATFORM_REVENUE
}

model Admin {
  id        String     @id @default(uuid())
  username  String?    @unique
  email     String?    @unique
  password  String?
  role      AdminRole? @default(ADMIN)
  isActive  Boolean?   @default(true) @map("is_active")
  lastLogin DateTime?  @map("last_login")
  createdAt DateTime?  @default(now()) @map("created_at")
  updatedAt DateTime?  @updatedAt @map("updated_at")

  @@map("admins")
}

model Creator {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(190)
  password          String?
  googleId          String?   @unique @map("google_id") @db.VarChar(64)
  slug              String    @unique @db.VarChar(64)
  displayName       String    @db.VarChar(80)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  bio               String?   @db.VarChar(300)
  whatIDo           String?   @map("what_i_do") @db.VarChar(1200)
  packagesSummary   String?   @map("packages_summary") @db.VarChar(1200)
  socialLinks       String?   @map("social_links") @db.VarChar(1200)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(800)
  thumbnailUrl      String?   @map("thumbnail_url") @db.VarChar(800)
  coverUrl          String?   @map("cover_url") @db.VarChar(800)
  primaryCategory   String?   @map("primary_category") @db.VarChar(80)
  supportEnabled    Boolean   @default(true) @map("support_enabled")
  onboardingComplete Boolean  @default(false) @map("onboarding_complete")
  isActive          Boolean   @default(true) @map("is_active")
  /// Admin approved TikTok/YouTube channel. Required before OBS stream links.
  streamVerifiedAt  DateTime? @map("stream_verified_at")
  streamLinksSubmittedAt DateTime? @map("stream_links_submitted_at")
  streamReviewNote  String?   @map("stream_review_note") @db.Text
  emailVerifiedAt   DateTime? @map("email_verified_at")
  emailVerificationTokenHash String? @map("email_verification_token_hash") @db.VarChar(128)
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  passwordResetTokenHash     String?   @map("password_reset_token_hash") @db.VarChar(128)
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at")
  lastLogin         DateTime? @map("last_login")
  /// Per-creator overrides for support/OBS/coaching settings (merged with global `settings` rows).
  workspaceSettings Json?     @map("workspace_settings")
  /// Shown to fans after they pay (and on the public page).
  fanThankYouMessage String?  @map("fan_thank_you_message") @db.VarChar(280)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  users            User[]
  payments         Payment[]
  subscriptions    Subscription[]
  creatorRewards   CreatorReward[]
  obsStreamLinks   ObsStreamLink[]
  payoutRequests   PayoutRequest[]
  payoutDestination CreatorPayoutDestination?
  ledgerEntries    LedgerEntry[]
  follows          FanFollow[]
  scheduledLives   ScheduledLive[]

  @@map("creators")
}

enum ScheduledLiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// Creator-announced live session (time, platform, description) shown on public/fan surfaces.
model ScheduledLive {
  id          String              @id @default(uuid())
  creatorId   String              @map("creator_id")
  title       String              @db.VarChar(120)
  description String?             @db.VarChar(1000)
  platform    String              @db.VarChar(32)
  startsAt    DateTime            @map("starts_at")
  endsAt      DateTime?           @map("ends_at")
  streamUrl   String?             @map("stream_url") @db.VarChar(500)
  status      ScheduledLiveStatus @default(SCHEDULED)
  cancelledAt DateTime?           @map("cancelled_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, startsAt])
  @@index([status, startsAt])
  @@map("scheduled_lives")
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
  CANCELLED
}

enum AdminRole {
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model Settings {
  id        String    @id @default(uuid())
  key       String?   @unique
  value     String?
  updatedAt DateTime? @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  @@map("settings")
}

/// Per–Browser Source tokens for OBS player + SSE (revocable).
model ObsStreamLink {
  id        String    @id @default(uuid())
  label     String?   @db.VarChar(128)
  token     String?   @unique
  revokedAt DateTime? @map("revoked_at")
  creatorId String?   @map("creator_id")
  createdAt DateTime? @default(now()) @map("created_at")

  creator Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@map("obs_stream_links")
}

enum CoachingBookingService {
  ACCOUNT_REVIEW
  RANK_PUSH
  BOTH
}

enum CoachingBookingStatus {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Public coaching / account review requests from the marketing site.
model CoachingBooking {
  id                String                  @id @default(uuid())
  service           CoachingBookingService  @map("service")
  name              String                  @db.VarChar(80)
  contact           String                  @db.VarChar(120)
  /// eFootball / game account to review (paid account review & bundle bookings).
  accountUsername   String?                 @map("account_username") @db.VarChar(120)
  availability      String?                 @map("availability") @db.VarChar(500)
  notes             String?                 @db.Text
  status            CoachingBookingStatus   @default(PENDING) @map("status")
  adminNotes        String?                 @map("admin_notes") @db.VarChar(1000)
  paymentId         String?                 @map("payment_id")
  payment           Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([paymentId])
  @@index([status, createdAt(sort: Desc)])
  @@map("coaching_bookings")
}

/// Admin-defined fixed-price “tier” (Patreon-style). Checkout creates Payment + CreatorRewardPurchase.
model CreatorReward {
  id                    String   @id @default(uuid())
  creatorId             String?  @map("creator_id")
  name                  String   @db.VarChar(80)
  description           String?  @db.Text
  amountKes             Decimal  @map("amount_kes") @db.Decimal(10, 2)
  /// Short ALL-CAPS style label on the OBS card (e.g. HYPE SQUAD!)
  alertBannerLabel      String   @map("alert_banner_label") @db.VarChar(40)
  /// Optional TTS line. Placeholders: {{displayName}}, {{rewardName}}, {{amount}}, {{message}}
  ttsScript             String?  @map("tts_script") @db.VarChar(600)
  allowSupporterMessage Boolean  @default(true) @map("allow_supporter_message")
  allowVideoClip        Boolean  @default(false) @map("allow_video_clip")
  maxMessageLength      Int      @default(200) @map("max_message_length")
  active                Boolean  @default(true)
  sortOrder             Int      @default(0) @map("sort_order")
  /// Optional #RRGGBB accent for the public subscribe card (null = site default amber).
  accentColor           String?  @map("accent_color") @db.VarChar(7)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  creator   Creator?                @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  purchases CreatorRewardPurchase[]

  @@index([creatorId])
  @@map("creator_rewards")
}

model CreatorRewardPurchase {
  id                  String   @id @default(uuid())
  paymentId           String   @unique @map("payment_id")
  rewardId            String   @map("reward_id")
  rewardNameSnapshot  String   @map("reward_name_snapshot") @db.VarChar(80)
  bannerLabelSnapshot String   @map("banner_label_snapshot") @db.VarChar(40)
  ttsScriptSnapshot   String?  @map("tts_script_snapshot") @db.VarChar(600)
  displayName         String   @map("display_name") @db.VarChar(64)
  platform            String   @default("tiktok") @db.VarChar(32)
  supporterMessage    String?  @map("supporter_message") @db.VarChar(500)
  videoUrl            String?  @map("video_url") @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at")

  payment Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reward  CreatorReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([rewardId])
  @@map("creator_reward_purchases")
}

model PayoutRequest {
  id              String              @id @default(uuid())
  creatorId       String              @map("creator_id")
  /// Requested withdrawal (gross of withdrawal fee).
  amountKes       Decimal             @map("amount_kes") @db.Decimal(14, 2)
  withdrawalFeeKes Decimal            @default(0) @map("withdrawal_fee_kes") @db.Decimal(14, 2)
  /// Amount sent to the creator after fee (amountKes - withdrawalFeeKes).
  payoutAmountKes Decimal?            @map("payout_amount_kes") @db.Decimal(14, 2)
  status          PayoutRequestStatus @default(PENDING)
  payoutChannel   String?             @map("payout_channel") @db.VarChar(80)
  payoutReference String?             @unique @map("payout_reference") @db.VarChar(120)
  destinationId   String?             @map("destination_id")
  notes           String?             @db.VarChar(1000)
  failureReason   String?             @map("failure_reason") @db.VarChar(500)
  reviewedBy      String?             @map("reviewed_by") @db.VarChar(120)
  reviewedAt      DateTime?           @map("reviewed_at")
  processedAt     DateTime?           @map("processed_at")
  paidAt          DateTime?           @map("paid_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  creator       Creator                    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  destination   CreatorPayoutDestination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([creatorId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("payout_requests")
}

/// Saved M-Pesa (or later bank) payout destination. Withdrawals use this row, not ad-hoc numbers.
model CreatorPayoutDestination {
  id         String    @id @default(uuid())
  creatorId  String    @unique @map("creator_id")
  channel    String    @default("MPESA") @db.VarChar(32)
  msisdn     String?   @db.VarChar(20)
  last4      String    @db.VarChar(4)
  bankCode   String?   @map("bank_code") @db.VarChar(32)
  bankName   String?   @map("bank_name") @db.VarChar(80)
  accountNumber String? @map("account_number") @db.VarChar(32)
  accountName   String? @map("account_name") @db.VarChar(80)
  paystackRecipientCode String? @map("paystack_recipient_code") @db.VarChar(64)
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  creator        Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payoutRequests PayoutRequest[]

  @@map("creator_payout_destinations")
}

/// Append-only financial history. Balances are the sum of these rows.
model LedgerEntry {
  id              String          @id @default(uuid())
  type            LedgerEntryType
  account         LedgerAccount
  amountKes       Decimal         @map("amount_kes") @db.Decimal(14, 2)
  currency        String          @default("KES") @db.VarChar(8)
  creatorId       String?         @map("creator_id")
  paymentId       String?         @map("payment_id")
  payoutRequestId String?         @map("payout_request_id")
  refundId        String?         @map("refund_id")
  relatedEntryId  String?         @map("related_entry_id")
  idempotencyKey  String          @unique @map("idempotency_key") @db.VarChar(160)
  description     String?         @db.VarChar(280)
  createdAt       DateTime        @default(now()) @map("created_at")

  creator       Creator?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  payment       Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  payoutRequest PayoutRequest?  @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)
  refund        PaymentRefund?  @relation(fields: [refundId], references: [id], onDelete: SetNull)

  @@index([creatorId, account, createdAt])
  @@index([paymentId, type])
  @@index([payoutRequestId])
  @@map("ledger_entries")
}

model PaymentRefund {
  id               String   @id @default(uuid())
  paymentId        String   @unique @map("payment_id")
  grossAmountKes   Decimal  @map("gross_amount_kes") @db.Decimal(14, 2)
  platformFeeKes   Decimal  @map("platform_fee_kes") @db.Decimal(14, 2)
  creatorAmountKes Decimal  @map("creator_amount_kes") @db.Decimal(14, 2)
  reason           String?  @db.VarChar(500)
  createdBy        String?  @map("created_by") @db.VarChar(120)
  createdAt        DateTime @default(now()) @map("created_at")

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@map("payment_refunds")
}
